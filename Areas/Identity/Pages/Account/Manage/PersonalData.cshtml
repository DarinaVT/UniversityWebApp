@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="manage-page-content">
    <h2 class="manage-page-title">@ViewData["Title"]</h2>
    
    <div class="manage-form-card">
        <div class="personal-data-info">
            <p class="mb-3">
                <i class="bi bi-info-circle me-2 text-primary"></i>
                Your account contains personal data that you have given us. This page allows you to download or delete that data.
            </p>
            <div class="alert alert-warning">
                <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Warning:</strong>
                <p class="mb-0 mt-2">Deleting this data will permanently remove your account, and this cannot be recovered.</p>
            </div>
        </div>
        
        <div class="personal-data-actions mt-4">
            <form id="download-data" asp-page="DownloadPersonalData" method="post" class="d-inline-block me-3">
                <button class="btn btn-primary btn-lg" type="submit">
                    <i class="bi bi-download me-2"></i>Download My Data
                </button>
            </form>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger btn-lg">
                <i class="bi bi-trash me-2"></i>Delete My Account
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
