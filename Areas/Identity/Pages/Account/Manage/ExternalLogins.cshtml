@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Manage your external logins";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<div class="manage-page-content">
    <h2 class="manage-page-title">@ViewData["Title"]</h2>
    <partial name="_StatusMessage" for="StatusMessage" />
    
    <div class="manage-form-card">
        @if (Model.CurrentLogins?.Count > 0)
        {
            <h4 class="section-subtitle mb-3">
                <i class="bi bi-link-45deg me-2"></i>Registered Logins
            </h4>
            <div class="table-responsive">
                <table class="table">
                    <tbody>
                        @foreach (var login in Model.CurrentLogins)
                        {
                            <tr>
                                <td id="@($"login-provider-{login.LoginProvider}")">
                                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                                    @login.ProviderDisplayName
                                </td>
                                <td class="text-end">
                                    @if (Model.ShowRemoveButton)
                                    {
                                        <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post" class="d-inline">
                                            <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                            <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove this @login.ProviderDisplayName login from your account">
                                                <i class="bi bi-x-circle me-1"></i>Remove
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        
        @if (Model.OtherLogins?.Count > 0)
        {
            <div class="mt-4 pt-4 border-top">
                <h4 class="section-subtitle mb-3">
                    <i class="bi bi-plus-circle me-2"></i>Add another service to log in
                </h4>
                <form id="link-login-form" asp-page-handler="LinkLogin" method="post" class="form-horizontal">
                    <div id="socialLoginList" class="d-flex flex-wrap gap-2">
                        @foreach (var provider in Model.OtherLogins)
                        {
                            <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                <i class="bi bi-link-45deg me-2"></i>@provider.DisplayName
                            </button>
                        }
                    </div>
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
