@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate two-factor authentication (2FA) recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="manage-page-content">
    <h2 class="manage-page-title">@ViewData["Title"]</h2>
    <partial name="_StatusMessage" for="StatusMessage" />
    
    <div class="manage-form-card">
        <div class="alert alert-warning">
            <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Put these codes in a safe place.</strong>
            <p class="mb-0 mt-2">
                If you lose your device and don't have the recovery codes you will lose access to your account.
            </p>
            <p class="mb-0 mt-2">
                Generating new recovery codes does not change the keys used in authenticator apps. If you wish to change the key
                used in an authenticator app you should <a asp-page="./ResetAuthenticator" class="alert-link">reset your authenticator keys</a>.
            </p>
        </div>
        
        <form method="post" class="mt-4">
            <button class="btn btn-danger btn-lg" type="submit">
                <i class="bi bi-key me-2"></i>Generate Recovery Codes
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
