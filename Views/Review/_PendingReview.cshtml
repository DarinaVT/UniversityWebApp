@model UniWebApp.ViewModels.University.ReviewViewModel

<div class="card mb-2 pending-review" id="pending-review-@Model.Id">
    <div class="card-body">
        <div class="d-flex align-items-center gap-2 mb-2">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="@Model.UserName" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
            }
            else
            {
                <i class="bi bi-person-circle" style="font-size: 40px; color: var(--text-color);"></i>
            }
            <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-center">
                    <strong>@Model.UserName</strong>
                    <span class="badge bg-warning">Pending</span>
                </div>
            </div>
        </div>

        <p class="mt-2 mb-1">⭐ @Model.Stars</p>
        <p class="mt-2 mb-1">@Model.Comment</p>

        <small class="text-muted">
            @Model.CreatedAt.ToString("dd MMM yyyy")
        </small>
    </div>
</div>

