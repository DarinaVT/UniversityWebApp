@model UniWebApp.ViewModels.Catalog.CatalogIndexViewModel


<div class="mb-3">
    <p class="text-muted mb-0">
        @Localizer["ShowingXOfYUniversities", (Model.Page - 1) * 12 + 1, Math.Min(Model.Page * 12, Model.TotalCount), Model.TotalCount]
    </p>
</div>


@if (Model.Universities.Any())
{
    <div class="row g-4 mb-4">
        @foreach (var uni in Model.Universities)
        {
            @if (Model.IsFavoritesPage)
            {
                <div class="col-12">
                    <partial name="_FavoritesCard" model="uni" view-data="ViewData" />
                </div>
            }
            else
            {
                <div class="col-md-6 col-lg-4">
                    <partial name="_UniversityCard" model="uni" />
                </div>
            }
        }
    </div>

    
    @if (Model.TotalPages > 1)
    {
        <partial name="_Pagination" model="Model" />
    }
}
else
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle me-2"></i>@Localizer["NoUniversitiesFound"]
    </div>
}

