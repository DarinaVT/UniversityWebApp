@using UniWebApp.ViewModels.Home
@model HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
}


<partial name="_HeroSection" />


<div class="home-section py-5">
    <div class="container">
        <h2 class="mb-4 text-center">@Localizer["FeaturedUniversities"]</h2>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var uni in Model.FeaturedUniversities)
            {
                <div class="col">
                    <partial name="_UniversityCard" model="uni" />
                </div>
            }
        </div>
    </div>
</div>


<div class="home-section py-5">
    <div class="container">
        <div class="row g-4 align-items-stretch">

            
            <div class="col-lg-6">
                <div class="card-white shadow-sm h-100">
                    <div class="card-body">
                        <h4 class="card-title mb-3">
                            <i class="bi bi-bar-chart-fill me-2 text-primary"></i>@Localizer["CountriesWithMostUniversities"]
                        </h4>
                        <canvas id="homeCountryStats" height="220" data-universities-label="@Localizer["Universities"]"></canvas>
                    </div>
                </div>
            </div>

            
            <div class="col-lg-6">
                <div class="card-white shadow-sm h-100">
                    <div class="card-body">
                        <h4 class="card-title mb-3">
                            <i class="bi bi-geo-alt-fill me-2 text-primary"></i>@Localizer["ExploreUniversitiesByCountry"]
                        </h4>
                        <div id="worldMap" style="height: 400px; border-radius: 8px;" data-rating-label="@Localizer["Rating"]"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="mapModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">World Universities Map</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="worldMapModal" style="height:100vh;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    
    <script src="~/js/home-search.js" asp-append-version="true"></script>

    
    <script src="~/js/home-country-stats.js" asp-append-version="true"></script>

    
    <script src="~/js/home-map.js" asp-append-version="true"></script>
}
