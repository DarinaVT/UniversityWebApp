@using Microsoft.AspNetCore.Identity
@using Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniWebApp</title>
    
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="alternate icon" href="~/favicon.ico" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UniWebApp.styles.css" asp-append-version="true" />

    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons@7.0.0/css/flag-icons.min.css" />

    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    
    <link rel="stylesheet" href="~/css/dark-mode.css" asp-append-version="true" />
</head>

<body>
<header class="navbar-header-wrapper">
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container-fluid">
            
            <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-mortarboard-fill me-2"></i>
                <span>UniWebApp</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="mainNav" class="collapse navbar-collapse">
                
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="btn btn-outline-primary btn-sm nav-link-btn" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>@Localizer["Home"]
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-primary btn-sm nav-link-btn" asp-area="" asp-controller="Universities" asp-action="Index">
                            <i class="bi bi-book me-1"></i>@Localizer["Catalog"]
                        </a>
                    </li>
                </ul>

                
                <div class="d-flex align-items-center gap-2">
                    @if (!SignInManager.IsSignedIn(User))
                    {
                        
                        <a class="btn btn-outline-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">
                            <i class="bi bi-person-plus me-1"></i>@Localizer["Register"]
                        </a>
                        <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>@Localizer["Login"]
                        </a>
                        
                        
                        <button id="themeToggle" class="btn btn-outline-secondary btn-sm" type="button" title="Toggle theme">
                            <i class="bi bi-moon-fill" id="themeIcon"></i>
                        </button>

                        
                        <div class="dropdown">
                            <button class="btn btn-link language-dropdown-btn dropdown-toggle" type="button" id="languageDropdown1" data-bs-toggle="dropdown" aria-expanded="false" title="Language">
                                <i class="bi bi-globe"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown1">
                                <li>
                                    <button type="button" class="dropdown-item @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "active" : "")" data-language="en">
                                        <span class="fi fi-gb me-2"></span>English
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? "active" : "")" data-language="bg">
                                        <span class="fi fi-bg me-2"></span>Български
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        var adminUser = await UserManager.GetUserAsync(User);
                        var adminDisplayName = adminUser?.DisplayName ?? adminUser?.UserName ?? adminUser?.Email ?? "Admin";
                        var adminProfilePic = adminUser?.ProfilePictureUrl;
                        
                        <a class="btn btn-outline-primary btn-sm" asp-area="" asp-controller="AdminDashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>@Localizer["Dashboard"]
                        </a>

                        
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" id="adminAccountDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (!string.IsNullOrEmpty(adminProfilePic))
                                {
                                    <img src="@adminProfilePic" alt="@adminDisplayName" class="rounded-circle" style="width: 24px; height: 24px; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle"></i>
                                }
                                <span>@adminDisplayName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminAccountDropdown">
                                <li>
                                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Profile">
                                        <i class="bi bi-person me-2"></i>@Localizer["Profile"]
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                        <i class="bi bi-gear me-2"></i>@Localizer["Settings"]
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right me-2"></i>@Localizer["Logout"]
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>

                        
                        <button id="themeToggle" class="btn btn-outline-secondary btn-sm" type="button" title="Toggle theme">
                            <i class="bi bi-moon-fill" id="themeIcon"></i>
                        </button>

                        
                        <div class="dropdown">
                            <button class="btn btn-link language-dropdown-btn dropdown-toggle" type="button" id="languageDropdown2" data-bs-toggle="dropdown" aria-expanded="false" title="Language">
                                <i class="bi bi-globe"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown2">
                                <li>
                                    <button type="button" class="dropdown-item @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "active" : "")" data-language="en">
                                        <span class="fi fi-gb me-2"></span>English
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? "active" : "")" data-language="bg">
                                        <span class="fi fi-bg me-2"></span>Български
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var displayName = currentUser?.DisplayName ?? currentUser?.UserName ?? currentUser?.Email ?? "User";
                        var profilePic = currentUser?.ProfilePictureUrl;
                        
                        <a class="btn btn-outline-primary btn-sm" asp-area="" asp-controller="Universities" asp-action="Favorites">
                            <i class="bi bi-heart me-1"></i>@Localizer["Favorites"]
                        </a>

                        
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" id="userAccountDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (!string.IsNullOrEmpty(profilePic))
                                {
                                    <img src="@profilePic" alt="@displayName" class="rounded-circle" style="width: 24px; height: 24px; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle"></i>
                                }
                                <span>@displayName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userAccountDropdown">
                                <li>
                                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Profile">
                                        <i class="bi bi-person me-2"></i>@Localizer["Profile"]
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                        <i class="bi bi-gear me-2"></i>@Localizer["Settings"]
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right me-2"></i>@Localizer["Logout"]
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>

                        
                        <button id="themeToggle" class="btn btn-outline-secondary btn-sm" type="button" title="Toggle theme">
                            <i class="bi bi-moon-fill" id="themeIcon"></i>
                        </button>

                        
                        <div class="dropdown">
                            <button class="btn btn-link language-dropdown-btn dropdown-toggle" type="button" id="languageDropdown3" data-bs-toggle="dropdown" aria-expanded="false" title="Language">
                                <i class="bi bi-globe"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown3">
                                <li>
                                    <button type="button" class="dropdown-item @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "active" : "")" data-language="en">
                                        <span class="fi fi-gb me-2"></span>English
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? "active" : "")" data-language="bg">
                                        <span class="fi fi-bg me-2"></span>Български
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted mt-4">
    <div class="container">
        &copy; 2025 - UniWebApp
    </div>
</footer>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/dropdown-fix.js" asp-append-version="true"></script>
<script src="~/js/theme.js" asp-append-version="true"></script>
<script src="~/js/localization.js" asp-append-version="true"></script>


@await RenderSectionAsync("Scripts", required: false)


<partial name="_LoginRegisterModal" />
</body>
</html>