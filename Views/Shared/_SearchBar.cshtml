<div class="container mt-4">
    <form method="get" asp-controller="Catalog" asp-action="Index">
        <div class="row g-2">
            <div class="col-md-10">
                <input type="text"
                       name="search"
                       class="form-control"
                       placeholder="Search university, city or country..." />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100">
                    Search
                </button>
            </div>
        </div>
    </form>
</div>