@model List<UniWebApp.ViewModels.Admin.AdminUniversityListViewModel>
@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    var search = ViewBag.Search as string ?? "";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalCount = (int)ViewBag.TotalCount;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Localizer["Universities"] (@totalCount @Localizer["Total"])</h2>
    <a asp-action="Create" class="btn btn-success">@Localizer["Add"]</a>
</div>

@Html.AntiForgeryToken()

<form method="get" class="mb-3">
    <input name="search" class="form-control" placeholder="@Localizer["Search"]" value="@search" />
    <input type="hidden" name="page" value="1" />
</form>

@if (Model.Any())
{
    <table class="table table-striped admin-table admin-universities-table">
        <thead>
            <tr>
                <th>@Localizer["Name"]</th>
                <th>@Localizer["Country"]</th>
                <th>@Localizer["City"]</th>
                <th>@Localizer["Rating"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @{
                int rowIndex = 0;
            }
            @foreach (var u in Model)
            {
                <tr class="admin-university-row" data-index="@rowIndex">
                    <td>@u.Name</td>
                    <td>@u.Country</td>
                    <td>@u.City</td>
                    <td>@u.Rating</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm admin-edit-btn">@Localizer["Edit"]</a>
                        <button class="btn btn-sm admin-delete-btn delete-university-btn" data-university-id="@u.Id" data-university-name="@u.Name">@Localizer["Delete"]</button>
                    </td>
                </tr>
                rowIndex++;
            }
        </tbody>
    </table>

    
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search">@Localizer["Previous"]</a>
                </li>
                
                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@search">@i</a>
                    </li>
                }
                
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search">@Localizer["Next"]</a>
                </li>
            </ul>
        </nav>
        
        <div class="text-center text-muted mt-2">
            @Localizer["ShowingXToYOfZ", (currentPage - 1) * 20 + 1, Math.Min(currentPage * 20, totalCount), totalCount]
        </div>
    }
}
else
{
    <div class="alert alert-info">
        @(string.IsNullOrWhiteSpace(search) ? Localizer["NoUniversitiesFound"] : Localizer["NoUniversitiesFoundMatching"])
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const deleteMessage = '@Localizer["AreYouSureDelete"]';
            const searchParam = '@search';
            const currentPage = @currentPage;
            
            document.querySelectorAll(".delete-university-btn").forEach(btn => {
                btn.addEventListener("click", async function() {
                    const universityId = this.dataset.universityId;
                    const universityName = this.dataset.universityName;
                    
                    if (!confirm(deleteMessage + " " + universityName + "?")) {
                        return;
                    }
                    
                    try {
                        const response = await fetch(`/AdminUniversity/Delete?id=${universityId}`, {
                            method: "POST",
                            headers: {
                                "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                            }
                        });
                        
                        if (response.ok) {
                            this.closest('tr').remove();
                            
                            const totalCountEl = document.querySelector('h2');
                            if (totalCountEl) {
                                const match = totalCountEl.textContent.match(/(\d+)/);
                                if (match) {
                                    const newCount = parseInt(match[1]) - 1;
                                    totalCountEl.textContent = totalCountEl.textContent.replace(/\d+/, newCount);
                                }
                            }
                            
                            const remainingRows = document.querySelectorAll('.admin-university-row');
                            if (remainingRows.length === 0) {
                                window.location.href = `/AdminUniversity/Index?search=${encodeURIComponent(searchParam)}&page=${currentPage}`;
                            }
                        } else {
                            alert("Error deleting university");
                        }
                    } catch (error) {
                        console.error("Error deleting university:", error);
                        alert("Error deleting university");
                    }
                });
            });
        });
    </script>
}
