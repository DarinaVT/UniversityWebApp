@model UniWebApp.ViewModels.AdminUserListViewModel
@using Microsoft.Extensions.Localization
@using UniWebApp.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = Localizer["UserDetails"].Value;
}

@Html.AntiForgeryToken()

<h2>@Localizer["UserDetails"]</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Localizer["EmailLabel"]:</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">@Localizer["UserId"]:</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">@Localizer["Registered"]:</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("g")</dd>

            <dt class="col-sm-3">@Localizer["ReviewsCount"]:</dt>
            <dd class="col-sm-9">@Model.ReviewsCount</dd>

            <dt class="col-sm-3">@Localizer["FavouritesCount"]:</dt>
            <dd class="col-sm-9">@Model.FavouritesCount</dd>
        </dl>

        <hr />

        <h5>@Localizer["ChangePassword"]</h5>
        <div class="mb-3">
            <input type="password" id="newPassword" class="form-control" placeholder="@Localizer["NewPasswordMinCharacters"]" />
            <small class="text-muted">@Localizer["EnterNewPasswordForUser"]</small>
        </div>
        <button class="btn btn-warning change-password-btn" data-user-id="@Model.Id">
            <i class="bi bi-key"></i> @Localizer["ChangePassword"]
        </button>

        <hr />

        <div class="mt-3">
            <a asp-controller="AdminUser" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> @Localizer["BackToUsers"]
            </a>
            <button class="btn btn-danger delete-user-btn" data-user-id="@Model.Id" data-user-email="@Model.Email">
                <i class="bi bi-trash"></i> @Localizer["DeleteUser"]
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const deleteUserMessage = '@Html.Raw(Localizer["AreYouSureDeleteUser", "{0}"])';
            const errorDeletingUser = '@Localizer["ErrorDeletingUser"]';
            const passwordMinLength = '@Localizer["PasswordMustBeAtLeast6Characters"]';
            const areYouSureChangePassword = '@Localizer["AreYouSureChangePassword"]';
            const passwordChangedSuccessfully = '@Localizer["PasswordChangedSuccessfully"]';
            const errorChangingPassword = '@Localizer["ErrorChangingPassword"]';
            const failedToChangePassword = '@Localizer["FailedToChangePassword"]';

            document.querySelector(".delete-user-btn")?.addEventListener("click", async function() {
                const userId = this.dataset.userId;
                const userEmail = this.dataset.userEmail;
                
                const deleteMessage = deleteUserMessage.replace('{0}', userEmail);
                if (!confirm(deleteMessage)) {
                    return;
                }
                
                try {
                    const response = await fetch(`/AdminUser/Delete?id=${userId}`, {
                        method: "POST",
                        headers: {
                            "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                        }
                    });
                    
                    if (response.ok) {
                        window.location.href = "/AdminUser";
                    } else {
                        alert(errorDeletingUser);
                    }
                } catch (error) {
                    console.error("Error deleting user:", error);
                    alert(errorDeletingUser);
                }
            });

            document.querySelector(".change-password-btn")?.addEventListener("click", async function() {
                const userId = this.dataset.userId;
                const newPassword = document.getElementById("newPassword")?.value;
                
                if (!newPassword || newPassword.length < 6) {
                    alert(passwordMinLength);
                    return;
                }
                
                if (!confirm(areYouSureChangePassword)) {
                    return;
                }
                
                try {
                    const response = await fetch(`/AdminUser/ChangePassword?id=${userId}`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                        },
                        body: JSON.stringify({ newPassword: newPassword })
                    });
                    
                    const result = await response.json();
                    
                    if (response.ok && result.success) {
                        alert(passwordChangedSuccessfully);
                        document.getElementById("newPassword").value = "";
                    } else {
                        alert(errorChangingPassword + ": " + (result.message || failedToChangePassword));
                    }
                } catch (error) {
                    console.error("Error changing password:", error);
                    alert(errorChangingPassword);
                }
            });
        });
    </script>
}

